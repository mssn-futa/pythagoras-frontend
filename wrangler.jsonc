{
  // Workers Static Assets: serves the Vite build with no Worker script (RELEASE-04, D5).
  // Build first with `npm run build:cloudflare` so dist/_headers exists. See docs/frontend-hosting.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pythagoras-frontend",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths (deep links such as /admin/quizzes/1) return /index.html with 200;
    // route guards in the SPA then decide what the visitor may see.
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
  // Custom domains/routes are account-specific and added at staging (see BLOCKED list in docs):
  // "routes": [{ "pattern": "<APP_HOSTNAME>", "custom_domain": true }]
}
