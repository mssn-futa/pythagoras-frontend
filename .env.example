# Copy to .env (git-ignored) for local development.
# Backend API origin only: no trailing slash and no /api/v1 prefix (D0).
# The client calls e.g. ${VITE_API_URL}/accounts/login/.
VITE_API_URL=http://127.0.0.1:8000

# --- Cloudflare hosting (RELEASE-04). Build-time, PUBLIC values only: origins, never secrets. ---
# `npm run build:cloudflare` renders dist/_headers (CSP etc.) from these and scans the bundle for secrets.
# Do not put provider/server secrets in any VITE_* or PUBLIC_* variable: they are embedded in public files.
# Defaults to VITE_API_URL's origin; if both are set they must match.
# PUBLIC_API_ORIGIN=https://api.example.org
# R2 public media custom domain (img/media). Not a public r2.dev URL.
PUBLIC_MEDIA_ORIGIN=https://media.example.org
# S3 endpoint host(s) that receive the browser's direct presigned PUT (comma-separated if bucket-style hosts are used).
R2_S3_PRESIGN_ORIGIN=https://<account-id>.r2.cloudflarestorage.com
# Optional: Google Fonts allowance (default on; =false drops it). The prayer-times API (https://api.aladhan.com) and
# geolocation stay OFF by default because D0 hides prayer/Hijri widgets in Phase 1; enable only if they return.
# PUBLIC_PRAYER_API_ORIGIN=https://api.aladhan.com
# PUBLIC_PRAYER_API_ENABLED=false
# PUBLIC_GOOGLE_FONTS_ENABLED=true
# Optional extra connect-src origins, comma-separated (e.g. a GA4 endpoint added by PLAT-08). Exact origins, no wildcards.
# PUBLIC_EXTRA_CONNECT_ORIGINS=
# Emit Content-Security-Policy-Report-Only instead of enforcing (staged rollout only).
# CSP_REPORT_ONLY=false
# Local proof only: accept http://localhost origins and omit HSTS/upgrade-insecure-requests.
# HOSTING_ALLOW_INSECURE=0
